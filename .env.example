# ──────────────────────────────────────────────────────────────
# SizoCare Environment Variables
# Copy this file to .env.local and fill in values
# ──────────────────────────────────────────────────────────────

# Supabase (local dev defaults — overridden by supabase start output)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-from-supabase-start

# Supabase Service Role (NEVER expose to client — Edge Functions only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-from-supabase-start

# Gemini API (NEVER expose to client — Edge Functions only)
GEMINI_API_KEY=your-gemini-api-key

# Google account sign-in. Configure the same credentials in Supabase Auth.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your-google-oauth-client-id
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Optional platform-owned AI keys. User-provided keys are kept in browser session storage only.
OPENROUTER_API_KEY=your-openrouter-api-key
OPENAI_API_KEY=your-openai-platform-api-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=SizoCare
