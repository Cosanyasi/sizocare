{
  "name": "sizocare",
  "private": true,
  "version": "0.1.0",
  "description": "SizoCare — caregiver-first companion platform for families supporting a relative with schizophrenia",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "pnpm test:unit",
    "test:unit": "vitest run",
    "test:integration": "node tests/integration/onboarding-rls.mjs",
    "test:e2e": "turbo test:e2e",
    "format": "prettier --write \"**/*.{js,cjs,mjs,ts,tsx,md,json,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{js,cjs,mjs,ts,tsx,md,json,yaml,yml}\"",
    "clean": "turbo clean",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:migrate": "supabase migration up",
    "db:types": "supabase gen types typescript --local > packages/shared-types/src/database.types.ts",
    "db:push:dry": "supabase db push --dry-run"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.55.0",
    "@supabase/supabase-js": "^2.57.4",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "supabase": "^2.117.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.28"
    }
  },
  "packageManager": "pnpm@9.15.0"
}
